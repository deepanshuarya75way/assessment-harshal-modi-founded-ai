# ===========================
# Founded AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===========================

# ── Database ─────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./founded.db

# PostgreSQL (uncomment and fill in for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/founded_db

# ── JWT Authentication ────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI / LLM ─────────────────────────────────────────────
# OpenAI or any OpenAI-compatible API (Groq, Together, etc.)
OPENAI_API_KEY=your-openai-api-key-here
# Optional: override base URL for other providers (e.g. https://api.groq.com/openai/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model to use for the copilot
OPENAI_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────
APP_NAME=Founded AI
APP_ENV=development
DEBUG=true
